generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum SiteStatus {
  NO_WEBSITE
  INSTAGRAM_ONLY
  WHATSAPP_ONLY
  FACEBOOK_ONLY
  LINK_AGGREGATOR
  HAS_WEBSITE
}

enum LeadStatus {
  NEW
  IN_PROGRESS
  CONTACTED
  REPLIED
  CLOSED
  DISCARDED
}

enum SearchStatus {
  RUNNING
  DONE
  LIMIT_REACHED
  FAILED
}

enum UserRole {
  ADMIN
  USER
}

enum ApiRequestStatus {
  PENDING
  SUCCESS
  ERROR
}

/// Uma linha por chamada HTTP à Places API. A contagem por `period` é o uso do mês, por usuário e por chave.
model ApiRequest {
  id           Int              @id @default(autoincrement())
  /// Mês de cobrança do Google no fuso America/Los_Angeles, no formato "2026-10".
  period       String
  page         Int
  status       ApiRequestStatus @default(PENDING)
  httpStatus   Int?
  resultsCount Int?
  error        String?
  /// Corpo da resposta do Google como veio (`places` e `nextPageToken`, ou o erro). `null` quando não houve resposta.
  response     Json?
  createdAt    DateTime         @default(now())
  finishedAt   DateTime?
  searchId     Int?
  search       Search?          @relation(fields: [searchId], references: [id])
  userId       Int
  user         User             @relation(fields: [userId], references: [id])
  /// HMAC da chave do Google usada (o mesmo de `User.googleApiKeyHash`). `null` nas requisições feitas antes
  /// de a chave ficar no banco, que contam pelo `userId`.
  keyHash      String?

  @@index([period])
  @@index([period, userId])
  @@index([period, keyHash])
}

model Search {
  id            Int          @id @default(autoincrement())
  city          String
  category      String
  neighborhood  String?
  textQuery     String
  maxPages      Int
  pagesFetched  Int          @default(0)
  resultsCount  Int          @default(0)
  newLeadsCount Int          @default(0)
  /// Verdadeiro quando a última página veio sem `nextPageToken`.
  exhausted     Boolean      @default(false)
  status        SearchStatus @default(RUNNING)
  error         String?
  createdAt     DateTime     @default(now())
  finishedAt    DateTime?
  userId        Int
  user          User         @relation(fields: [userId], references: [id])
  requests      ApiRequest[]
  userLeads     UserLead[]
  results       SearchLead[]

  @@index([textQuery])
  @@index([userId, createdAt])
}

/// Uma empresa do Google, a mesma para todos os usuários. Cada busca que a reencontra sobrescreve estes dados.
/// O que é de cada usuário (status, anotações e busca de origem) fica em `UserLead`.
model Lead {
  /// `places.id` do Google.
  id                 String       @id
  name               String
  address            String?
  /// Bairro informado pelo Google em `addressComponents`.
  neighborhood       String?
  /// Sigla do estado ("CE"), vinda de `addressComponents` (administrative_area_level_1).
  state              String?
  primaryType        String?
  primaryTypeName    String?
  nationalPhone      String?
  internationalPhone String?
  websiteUri         String?
  siteStatus         SiteStatus
  rating             Float?
  userRatingCount    Int?
  googleMapsUri      String?
  businessStatus     String?
  types              String[]     @default([])
  /// Atende os clientes no local deles e não tem endereço físico no Maps.
  pureServiceArea    Boolean?
  /// `regularOpeningHours.weekdayDescriptions`, um texto por dia da semana.
  openingHours       String[]     @default([])
  priceLevel         String?
  reviewsUri         String?
  photosUri          String?
  /// Objeto Place completo devolvido pela Text Search, com todos os campos do field mask.
  googleData         Json?
  firstSeenAt        DateTime     @default(now())
  lastSeenAt         DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  users              UserLead[]
  searchResults      SearchLead[]

  @@index([siteStatus])
}

/// Empresa na lista de um usuário. Os campos daqui são só dele e nunca são sobrescritos por uma busca.
model UserLead {
  userId             Int
  leadId             String
  status             LeadStatus @default(NEW)
  notes              String?
  /// Cidade da busca que trouxe a empresa para o usuário pela primeira vez.
  city               String
  /// Categoria dessa mesma busca.
  category           String
  /// Bairro dessa mesma busca.
  searchNeighborhood String?
  firstSearchId      Int?
  /// Quando a empresa entrou na lista do usuário.
  firstSeenAt        DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  user               User       @relation(fields: [userId], references: [id])
  lead               Lead       @relation(fields: [leadId], references: [id])
  firstSearch        Search?    @relation(fields: [firstSearchId], references: [id])

  @@id([userId, leadId])
  @@index([leadId])
  @@index([userId, status])
  @@index([userId, city, category])
}

/// Empresas que cada busca trouxe. Um lead aparece aqui uma vez por busca que o encontrou.
model SearchLead {
  searchId  Int
  leadId    String
  page      Int
  createdAt DateTime @default(now())
  search    Search   @relation(fields: [searchId], references: [id])
  lead      Lead     @relation(fields: [leadId], references: [id])

  @@id([searchId, leadId])
  @@index([leadId])
  @@index([createdAt])
}

/// Quem pode usar o app. Só é criado pelo terminal (`bun run user:create`); não há cadastro pela API.
model User {
  id               Int          @id @default(autoincrement())
  /// Sempre em minúsculas.
  email            String       @unique
  /// "salt:hash" do scrypt, em hexadecimal. A senha nunca é guardada.
  passwordHash     String
  /// `ADMIN` também vê o painel com os usuários, as empresas e as entradas de cada um.
  role             UserRole     @default(USER)
  /// Chave da API do Google, cifrada com AES-256-GCM (`ENCRYPTION_KEY`). Nunca volta para o front.
  googleApiKey     String?
  /// HMAC-SHA256 da chave: impede a mesma chave em duas contas e conta o uso do mês por chave.
  googleApiKeyHash String?      @unique
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  searches         Search[]
  apiRequests      ApiRequest[]
  leads            UserLead[]
  accesses         UserAccess[]
}

/// Uma entrada do usuário no app. Aberturas com menos de 30 minutos de intervalo contam como a mesma entrada.
model UserAccess {
  id         Int      @id @default(autoincrement())
  userId     Int
  startedAt  DateTime @default(now())
  /// Última abertura do app dentro dessa entrada.
  lastSeenAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])

  @@index([userId, startedAt])
}
